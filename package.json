{
  "name": "x-design-system",
  "displayName": "X Design System",
  "description": "Visual theme studio and design system generator for VS Code with live preview and theme spec generator",
  "version": "1.0.0",
  "publisher": "Oluwateezzy",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oluwateezzy/X-design-studio"
  },
  "homepage": "https://github.com/Oluwateezzy/X-design-studio#readme",
  "bugs": {
    "url": "https://github.com/Oluwateezzy/X-design-studio/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "color-palette",
    "design-system",
    "css",
    "typography",
    "export",
    "vscode-theme"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xDesignSystemActivityBar",
          "title": "X Design System",
          "icon": "public/favicon.svg"
        }
      ]
    },
    "views": {
      "xDesignSystemActivityBar": [
        {
          "type": "webview",
          "id": "xDesignSystemSidebarView",
          "name": "X Design System"
        }
      ]
    },
    "commands": [
      {
        "command": "xDesignSystem.open",
        "title": "Open X Design System",
        "category": "X Design System"
      }
    ],
    "configuration": {
      "title": "X Design System",
      "properties": {
        "xDesignSystem.googleFontsApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Fonts API key for custom font preview"
        },
        "xDesignSystem.defaultExportFormat": {
          "type": "string",
          "enum": [
            "vsCodeTheme",
            "tailwindConfig",
            "cssVariables",
            "jsonTheme"
          ],
          "default": "vsCodeTheme",
          "description": "Default theme export format"
        }
      }
    },
    "keybindings": [
      {
        "command": "xDesignSystem.open",
        "key": "cmd+shift+t",
        "mac": "cmd+shift+t",
        "win": "ctrl+shift+t"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build:extension": "node esbuild.config.mjs",
    "build:webview": "vite build --config vite.config.webview.mjs",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "node esbuild.config.mjs --watch",
    "watch:webview": "vite build --watch --config vite.config.webview.mjs",
    "watch": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/vsce": "^3.7.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
